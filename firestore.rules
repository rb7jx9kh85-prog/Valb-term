rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // requests/{id}: name, phone, email, service, project, message, status,
    //                 meeting, source, createdAt, updatedAt
    // projectCards/{id}: title, category, description, order, visible,
    //                    imageUrl, storagePath, createdAt, updatedAt
    // admins/{uid}: active

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function validEmail(value) {
      return value is string
        && value.size() <= 160
        && (value.size() == 0 || value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'));
    }

    function validRequest() {
      return request.resource.data.keys().hasOnly(['name','phone','email','service','project','message','status','meeting','source','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['name','phone','email','service','project','message','status','meeting','source','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && validEmail(request.resource.data.email)
        && (request.resource.data.phone.size() > 0 || request.resource.data.email.size() > 0)
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() >= 2
        && request.resource.data['service'].size() <= 100
        && request.resource.data.project is string
        && request.resource.data.project.size() >= 2
        && request.resource.data.project.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status in ['Nouveau','En cours','Rendez-vous','Terminé']
        && (request.resource.data.meeting == null || request.resource.data.meeting is timestamp)
        && request.resource.data.source in ['site-web','admin']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPublicRequest() {
      return validRequest()
        && request.resource.data.status == 'Nouveau'
        && request.resource.data.meeting == null
        && request.resource.data.source == 'site-web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminRequestCreate() {
      return validRequest()
        && request.resource.data.source == 'admin'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminRequestUpdate() {
      return validRequest()
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validProjectCard() {
      return request.resource.data.keys().hasOnly(['title','category','description','order','visible','imageUrl','storagePath','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['title','category','description','order','visible','imageUrl','storagePath','createdAt','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.category in ['Sanitaire','Chauffage','Lavabos & salles de bains','Pompe à chaleur','Ventilation']
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 2
        && request.resource.data.description.size() <= 220
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && request.resource.data.visible is bool
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.imageUrl.matches('^https://.*')
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() <= 180
        && request.resource.data.storagePath.matches('^project-cards/[A-Za-z0-9-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validProjectCardCreate() {
      return validProjectCard()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validProjectCardUpdate() {
      return validProjectCard()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /requests/{requestId} {
      allow create: if validPublicRequest()
        || (isAdmin() && validAdminRequestCreate());
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && validAdminRequestUpdate();
    }

    match /projectCards/{cardId} {
      allow read: if isAdmin() || resource.data.visible == true;
      allow create: if isAdmin() && validProjectCardCreate();
      allow update: if isAdmin() && validProjectCardUpdate();
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
